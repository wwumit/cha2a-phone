{
  "name": "cha2a-phone",
  "version": "1.1.3",
  "description": "Cha2a Phone — A2A-ready agent phone channel for OpenClaw: CHA2A 号码簿寻址 + DID 身份 + 信任等级 L0-L4 + RCS 群聊（图片附件）+ 短信中继 + 自注册。Bundled skill and phone UI asset.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/wwumit/cha2a-phone"
  },
  "dependencies": {
    "typebox": "1.3.16"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.24-beta.2"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "install": {
      "clawhubSpec": "clawhub:cha2a-phone",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.8.1"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "openclawVersion": "2026.8.1",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true
    }
  }
}